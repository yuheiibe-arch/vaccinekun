/**
 * =======================================================================================
 * トリガー設定用メインファイル
 * =======================================================================================
 * このファイルにある `triggerUpdateAllReports` 関数を、
 * 時間主導型トリガー（例：毎日午前1時〜2時）に設定してください。
 *
 * この関数が、ReportGenerator.gs にあるメイン処理を呼び出します。
 */
function triggerUpdateAllReports() {
  Logger.log('トリガーにより全レポート更新処理を開始します。');
  updateAllReports();
  Logger.log('トリガーによる全レポート更新処理が完了しました。');
}
